---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Overview">
  <svg class="icon-sprite" aria-hidden="true">
    <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3 2.8 19a1.4 1.4 0 0 0 1.2 2h16a1.4 1.4 0 0 0 1.2-2L12 3Z"/><path d="M12 9v4M12 17h.01"/></symbol>
    <symbol id="i-rocket" viewBox="0 0 24 24"><path d="M15 4.2c2.2-1.2 4.4-1.1 5.8-1-.1 1.4.2 3.7-1 5.8l-5.2 5.2-4.8-4.8L15 4.2Z"/><path d="m9.8 9.4-4.2.7-2.2 2.2 5.4 1.1M14.6 14.2l-.7 4.2-2.2 2.2-1.1-5.4"/><circle cx="16.5" cy="7.5" r="1.5"/></symbol>
    <symbol id="i-pulse" viewBox="0 0 24 24"><path d="M3 12h4l2-7 4 14 2-7h6"/></symbol>
    <symbol id="i-log" viewBox="0 0 24 24"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
    <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6h7l2 2h9v11H3z"/></symbol>
    <symbol id="i-key" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"/><path d="m11 12 8-8M16 7l2 2M14 9l2 2"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1l2-1.5-2-3.4-2.4 1A8 8 0 0 0 15 6l-.3-2.6h-4L10.5 6A8 8 0 0 0 9 7.1l-2.4-1-2 3.4 2 1.5a7 7 0 0 0 0 2l-2 1.5 2 3.4 2.4-1A8 8 0 0 0 10.5 18l.2 2.6h4L15 18a8 8 0 0 0 1.5-1.1l2.4 1 2-3.4-2-1.5a7 7 0 0 0 .1-1Z"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></symbol>
    <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 15.2A8 8 0 0 1 8.8 4 8 8 0 1 0 20 15.2Z"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9"/></symbol>
  </svg>

  <div class="app-shell" id="app" aria-busy="true">
    <header class="app-header">
      <button class="icon-button mobile-menu" id="mobile-menu" aria-label="Open navigation"><svg><use href="#i-menu"></use></svg></button>
      <a class="wordmark" href="/ui/" data-route="overview" aria-label="Barktrace overview"><img src="/ui/brand-mark.svg" alt="" /><span class="wordmark-text">barktrace<b>.</b></span></a>
      <div class="header-tools">
        <label class="global-search"><svg><use href="#i-search"></use></svg><input id="global-search" placeholder="Filter this view" autocomplete="off" /><kbd>/</kbd></label>
        <button class="icon-button" id="theme-toggle" aria-label="Toggle color theme"><svg><use href="#i-moon"></use></svg></button>
        <button class="avatar" id="account-button" aria-label="Account menu">?</button>
        <div class="account-menu panel" id="account-menu" hidden><strong id="account-name"></strong><span id="account-email" class="muted"></span><hr /><button id="logout"><svg><use href="#i-logout"></use></svg> Sign out</button></div>
      </div>
    </header>

    <aside class="sidebar" id="sidebar">
      <div class="context-picker">
        <label for="organization">Organization</label>
        <div class="select-wrap"><select id="organization"></select><span>⌄</span></div>
        <label for="project">Project</label>
        <div class="project-picker"><span class="project-avatar" id="project-avatar">–</span><div><select id="project"></select><small id="project-slug">No project selected</small></div></div>
      </div>
      <nav class="primary-nav" aria-label="Workspace">
        <p class="nav-label">Observe</p>
        <a href="/ui/" data-route="overview"><svg><use href="#i-grid"></use></svg><span>Overview</span></a>
        <a href="/ui/issues/" data-route="issues"><svg><use href="#i-alert"></use></svg><span>Issues</span><b id="issue-count">0</b></a>
        <a href="/ui/releases/" data-route="releases"><svg><use href="#i-rocket"></use></svg><span>Releases</span></a>
        <a href="/ui/performance/" data-route="performance"><svg><use href="#i-pulse"></use></svg><span>Performance</span></a>
        <a href="/ui/logs/" data-route="logs"><svg><use href="#i-log"></use></svg><span>Logs</span></a>
        <a href="/ui/discover/" data-route="discover"><svg><use href="#i-search"></use></svg><span>Discover</span></a>
        <a href="/ui/dashboards/" data-route="dashboards"><svg><use href="#i-grid"></use></svg><span>Dashboards</span></a>
        <a href="/ui/uptime/" data-route="uptime"><svg><use href="#i-clock"></use></svg><span>Uptime</span></a>
		<a href="/ui/telemetry/" data-route="telemetry"><svg><use href="#i-grid"></use></svg><span>Telemetry</span></a>
        <p class="nav-label">Manage</p>
        <a href="/ui/projects/" data-route="projects"><svg><use href="#i-folder"></use></svg><span>Projects</span></a>
        <a href="/ui/setup/" data-route="setup"><svg><use href="#i-key"></use></svg><span>SDK setup</span></a>
        <a href="/ui/settings/" data-route="settings"><svg><use href="#i-settings"></use></svg><span>Organization</span></a>
      </nav>
      <div class="sidebar-foot"><span class="status-dot"></span> All systems operational</div>
    </aside>

    <main class="workspace">
      <div class="loading-state" id="loading-state"><span class="spinner"></span> Loading workspace…</div>
      <div class="page" id="page" hidden>
        <header class="page-header"><div><p class="breadcrumb" id="breadcrumb"></p><h1 id="page-title">Overview</h1><p class="page-subtitle" id="page-subtitle"></p></div><div class="page-actions" id="page-actions"></div></header>
        <div id="view"></div>
      </div>
    </main>
  </div>

  <dialog id="project-dialog"><form id="create-project"><div class="dialog-heading"><div><p class="eyebrow">New project</p><h2>Start collecting events</h2></div><button type="button" class="dialog-close" data-close aria-label="Close">×</button></div><label>Project name<input required name="name" placeholder="Checkout API" autocomplete="off" /></label><label>Platform<select name="platform"><option value="javascript">JavaScript</option><option value="go">Go</option><option value="python">Python</option><option value="rust">Rust</option><option value="">Other</option></select></label><p class="form-error" id="project-error" hidden></p><div class="dialog-actions"><button type="button" class="button secondary" data-close>Cancel</button><button class="button" type="submit">Create project</button></div></form></dialog>
  <dialog id="organization-dialog"><form id="create-organization"><div class="dialog-heading"><div><p class="eyebrow">New organization</p><h2>Create a workspace</h2></div><button type="button" class="dialog-close" data-close aria-label="Close">×</button></div><label>Name<input required name="name" placeholder="Acme" autocomplete="off" /></label><label>Slug<input required name="slug" placeholder="acme" autocomplete="off" pattern="[a-z0-9-]+" /></label><p class="form-error" id="organization-error" hidden></p><div class="dialog-actions"><button type="button" class="button secondary" data-close>Cancel</button><button class="button" type="submit">Create organization</button></div></form></dialog>
  <dialog id="monitor-dialog"><form id="create-monitor"><div class="dialog-heading"><div><p class="eyebrow">New uptime monitor</p><h2>Watch an HTTP endpoint</h2></div><button type="button" class="dialog-close" data-close aria-label="Close">×</button></div><label>Name<input required name="name" placeholder="Production API" autocomplete="off" /></label><label>URL<input required name="url" type="url" placeholder="https://api.example.com/health" autocomplete="off" /></label><div class="form-grid"><label>Method<select name="method"><option>GET</option><option>HEAD</option></select></label><label>Check every<select name="interval_seconds"><option value="60">1 minute</option><option value="300">5 minutes</option><option value="900">15 minutes</option><option value="3600">1 hour</option></select></label></div><label>Timeout<select name="timeout_seconds"><option value="5">5 seconds</option><option value="10" selected>10 seconds</option><option value="20">20 seconds</option><option value="30">30 seconds</option></select></label><p class="form-help">Successful responses are HTTP 200–399. Redirects are followed up to five times.</p><p class="form-error" id="monitor-error" hidden></p><div class="dialog-actions"><button type="button" class="button secondary" data-close>Cancel</button><button class="button" type="submit">Create and check</button></div></form></dialog>
  <div class="toast" id="toast" role="status" hidden></div>
  <script is:inline src="/ui/app.js"></script>
</Layout>
