BARKTRACE_ADDR=:8080
BARKTRACE_DATA_DIR=./data
# Optional replicated SQLite/libSQL metadata service. Leave empty for the
# default local SQLite database. Keep the authentication token secret.
BARKTRACE_DATABASE_URL=
BARKTRACE_DATABASE_AUTH_TOKEN=
BARKTRACE_PUBLIC_URL=http://localhost:8080
BARKTRACE_DEFAULT_ORG_NAME=Default
BARKTRACE_DEFAULT_ORG_SLUG=default
BARKTRACE_AUTO_PROVISION=true
BARKTRACE_SESSION_LIFETIME_HOURS=720
BARKTRACE_RATE_LIMIT_PER_MINUTE=1000
GOMEMLIMIT=96MiB

# Optional stateless MCP endpoint at /mcp. Generate with: openssl rand -hex 32
# This legacy instance-wide token can be omitted when organization tokens are
# created from the Barktrace dashboard.
BARKTRACE_MCP_TOKEN=

# Keep false on internet-facing deployments. Enable only for trusted intranet checks.
BARKTRACE_UPTIME_ALLOW_PRIVATE_TARGETS=false

# Optional SMTP delivery for email alert destinations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Blob storage. Keep "local" for one-node deployments. Use "s3" with an
# S3-compatible bucket when artifact/replay/profile payloads must be shared.
BARKTRACE_BLOB_BACKEND=local
BARKTRACE_S3_ENDPOINT=
BARKTRACE_S3_REGION=us-east-1
BARKTRACE_S3_BUCKET=
BARKTRACE_S3_ACCESS_KEY_ID=
BARKTRACE_S3_SECRET_ACCESS_KEY=
BARKTRACE_S3_SESSION_TOKEN=
BARKTRACE_S3_PREFIX=barktrace
BARKTRACE_S3_ALLOW_HTTP=false

# Generic OIDC / Pocket ID. SSO is the primary authentication mechanism.
OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=barktrace
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback
OIDC_PROVIDER_NAME=Pocket ID
OIDC_SCOPES=openid email profile
OIDC_REQUIRE_EMAIL_VERIFIED=true
