# Public URL served by Dokploy. Do not add a path or trailing slash.
BARKTRACE_PUBLIC_URL=https://errors.example.com

# Leave empty for the standard single-replica local SQLite deployment. For
# multiple Barktrace replicas, use one shared libSQL database plus S3 blobs.
BARKTRACE_DATABASE_URL=
BARKTRACE_DATABASE_AUTH_TOKEN=

# The first OIDC user becomes owner of this organization.
BARKTRACE_DEFAULT_ORG_NAME=Acme
BARKTRACE_DEFAULT_ORG_SLUG=acme
BARKTRACE_AUTO_PROVISION=true
BARKTRACE_SESSION_LIFETIME_HOURS=720
BARKTRACE_RATE_LIMIT_PER_MINUTE=1000

# Pocket ID / generic OpenID Connect.
OIDC_ISSUER_URL=https://id.example.com
OIDC_CLIENT_ID=barktrace
OIDC_CLIENT_SECRET=replace-with-the-provider-secret
OIDC_REDIRECT_URL=https://errors.example.com/auth/oidc/callback
OIDC_PROVIDER_NAME=Pocket ID
OIDC_SCOPES=openid email profile
OIDC_REQUIRE_EMAIL_VERIFIED=true

# Optional legacy instance-wide MCP token. Organization-scoped credentials can
# instead be created from the dashboard after the first login.
BARKTRACE_MCP_TOKEN=

# Enable only when intentionally checking trusted private/intranet services.
BARKTRACE_UPTIME_ALLOW_PRIVATE_TARGETS=false

# Optional email alerts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=barktrace
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=alerts@example.com
SMTP_TLS_MODE=starttls

# Local storage is recommended for the standard one-replica Dokploy setup.
BARKTRACE_BLOB_BACKEND=local
# For shared S3-compatible payload storage, switch to s3 and fill these values:
BARKTRACE_S3_ENDPOINT=
BARKTRACE_S3_REGION=us-east-1
BARKTRACE_S3_BUCKET=
BARKTRACE_S3_ACCESS_KEY_ID=
BARKTRACE_S3_SECRET_ACCESS_KEY=
BARKTRACE_S3_SESSION_TOKEN=
BARKTRACE_S3_PREFIX=barktrace
BARKTRACE_S3_ALLOW_HTTP=false

# Keep below the container memory limit.
GOMEMLIMIT=96MiB
